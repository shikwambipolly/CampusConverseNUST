# =============================================================================
# CampusConverse NUST — Environment Configuration Template
# Copy this file to .env (`cp .env.example .env`) and fill in values as needed.
# Note: The pipeline runs 100% locally offline if GEMINI_API_KEY is left blank.
# =============================================================================

# 1. LLM Synthesis Provider ("auto" | "gemini" | "ollama" | "offline")
LLM_PROVIDER="auto"

# Option A: Google Gemini LLM Synthesis (Cloud API)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Option B: Open-Source Ollama LLM Synthesis (Local / Docker Container)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# 2. Chroma Vector Database Configuration
CHROMA_PERSIST_DIR="./chroma_db"
USE_REMOTE_CHROMA="false"
CHROMA_HOST="localhost"
CHROMA_PORT="8000"

# 3. Structured Database Configuration (Defaults to local SQLite data/nust_facts.db)
SQLITE_PATH="./data/nust_facts.db"
USE_ALLOYDB="false"
ALLOYDB_HOST="127.0.0.1"
ALLOYDB_PORT="5432"
ALLOYDB_DATABASE="nust_campus_db"
ALLOYDB_USER="postgres"
ALLOYDB_PASSWORD="postgres"

# 4. API / MCP Server Port
PORT="8080"
